/target
**/*.rs.bk

# secrets — never commit
.env
*.key
*.nsec
*.enc
*.ncryptsec
audit.log
.DS_Store

# sealed keys: encrypted, but never publish them
*.sealed.json

# local operator policy - the committed template is policy.example.json
policy.json

# local operator config - the committed templates are *.example.json
identities.json
agents.json

# agent credentials: the bunker itself only ever stores their SHA-256
*.token

# enclave: dev identity and configuration, and build outputs (the EIF embeds sealed keys)
enclave/conf/
enclave/out/
